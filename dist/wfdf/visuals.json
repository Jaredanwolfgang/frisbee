{"checked":"2026-10-25","license":"CC BY 4.0","author":"World Flying Disc Federation","entries":[{"id":"signal-01","kind":"signal","number":1,"title":"犯规","en":"Foul","description":"一臂平伸，另一前臂向下切过平伸的手臂。","refs":["15.1","17"],"aliases":["犯规","危险动作","foul","strip"],"image":"wfdf/visuals/signal-01.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=1"},{"id":"signal-02","kind":"signal","number":2,"title":"违例","en":"Violation","description":"双手握拳举过头顶，形成 V 字。","refs":["15.3","18.1.4","18.2.6"],"aliases":["违例","violation"],"image":"wfdf/visuals/signal-02.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=1"},{"id":"signal-03","kind":"signal","number":3,"title":"得分","en":"Goal","description":"双臂完全伸直向上举，掌心相对。","refs":["14"],"aliases":["得分","端区","goal","score"],"image":"wfdf/visuals/signal-03.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=1"},{"id":"signal-04","kind":"signal","number":4,"title":"有争议","en":"Contest","description":"双拳在胸前相碰，手背朝外。","refs":["15.10","1.12","13.4"],"aliases":["争议","contest","不认"],"image":"wfdf/visuals/signal-04.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=1"},{"id":"signal-05","kind":"signal","number":5,"title":"接受示意","en":"Accepted","description":"双肘贴住躯干，前臂向前伸，掌心向上。","refs":["15.10","17"],"aliases":["接受","无争议","accepted"],"image":"wfdf/visuals/signal-05.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=1"},{"id":"signal-06","kind":"signal","number":6,"title":"撤回示意","en":"Retracted","description":"双臂向下伸在身前，交叉挥动。","refs":["15.11","16.3"],"aliases":["撤回","retracted"],"image":"wfdf/visuals/signal-06.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=1"},{"id":"signal-07","kind":"signal","number":7,"title":"界内 / 界外 / 得分区外","en":"In / Out","description":"手臂伸直、手掌平展，指向场内表示界内，指向场外表示界外。","refs":["11","14.1"],"aliases":["出界","界内","踩线","out of bounds","in bounds"],"image":"wfdf/visuals/signal-07.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=1"},{"id":"signal-08","kind":"signal","number":8,"title":"盘落地","en":"Down","description":"手臂斜向下约 45 度伸直，食指指向地面。","refs":["13.1.1"],"aliases":["落地","down"],"image":"wfdf/visuals/signal-08.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=1"},{"id":"signal-09","kind":"signal","number":9,"title":"盘未落地","en":"Up","description":"手肘向下、前臂竖直，食指朝上。","refs":["12.1"],"aliases":["盘未落地","接住","up"],"image":"wfdf/visuals/signal-09.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=1"},{"id":"signal-10","kind":"signal","number":10,"title":"阻挡","en":"Pick","description":"双臂抬起、手肘弯曲，双拳朝向头部。","refs":["18.3"],"aliases":["pick","阻挡","挡拆"],"image":"wfdf/visuals/signal-10.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=1"},{"id":"signal-11","kind":"signal","number":11,"title":"走步","en":"Travel","description":"双手握拳，在身体前方沿竖直圆圈转动手腕。","refs":["18.2"],"aliases":["走步","走几步","跑几步","travel","轴心","pivot"],"image":"wfdf/visuals/signal-11.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=1"},{"id":"signal-12","kind":"signal","number":12,"title":"防盘违规","en":"Marking Infraction","description":"双臂向两侧伸直，掌心朝前。","refs":["18.1"],"aliases":["防盘","双人防守","包夹","快数","间距","double team","disc space","wrapping","fast count"],"image":"wfdf/visuals/signal-12.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=1"},{"id":"signal-13","kind":"signal","number":13,"title":"攻防转换","en":"Turnover","description":"右臂在身前伸直，掌心先朝上，再转向下。","refs":["13"],"aliases":["转换","turnover"],"image":"wfdf/visuals/signal-13.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=2"},{"id":"signal-14","kind":"signal","number":14,"title":"时间违例","en":"Timing Violation","description":"张开手掌，轻拍头顶。","refs":["9","10.5","A5"],"aliases":["读秒","超时","数秒","stall","时间违例"],"image":"wfdf/visuals/signal-14.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=2"},{"id":"signal-15","kind":"signal","number":15,"title":"越位 / 提前启动","en":"Offside / False Start","description":"双臂在头顶交叉成 X 字，双手握拳。","refs":["7.5"],"aliases":["越位","提前启动","offside","false start"],"image":"wfdf/visuals/signal-15.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=2"},{"id":"signal-16","kind":"signal","number":16,"title":"暂停","en":"Time-out","description":"双手，或一只手和飞盘，组成 T 字。","refs":["20"],"aliases":["暂停","time-out","time out"],"image":"wfdf/visuals/signal-16.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=2"},{"id":"signal-17","kind":"signal","number":17,"title":"精神暂停","en":"Spirit Stoppage","description":"用双手组成倒 T 字。","refs":["1","A13"],"aliases":["飞盘精神","精神暂停","spirit"],"image":"wfdf/visuals/signal-17.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=2"},{"id":"signal-18","kind":"signal","number":18,"title":"受伤 / 技术中断","en":"Injury / Technical","description":"双手相握，弯曲双臂举过头顶。","refs":["19"],"aliases":["受伤","流血","技术中断","injury","technical"],"image":"wfdf/visuals/signal-18.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=2"},{"id":"signal-19","kind":"signal","number":19,"title":"对位比例：男性","en":"Male Matching","description":"双手扣在脑后，手肘向两侧打开。","refs":["5.4","6.4","A6"],"aliases":["男女比例","混合","mixed","male matching","abba"],"image":"wfdf/visuals/signal-19.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=2"},{"id":"signal-20","kind":"signal","number":20,"title":"对位比例：女性","en":"Female Matching","description":"双臂向两侧伸直，双手握拳。","refs":["5.4","6.4","A6"],"aliases":["男女比例","混合","mixed","female matching","abba"],"image":"wfdf/visuals/signal-20.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=2"},{"id":"signal-21","kind":"signal","number":21,"title":"比赛已停止","en":"Play Has Stopped","description":"双臂伸直举过头顶，交叉挥动。","refs":["15.7","8.1.3"],"aliases":["停止","中断","stopped"],"image":"wfdf/visuals/signal-21.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=2"},{"id":"signal-22","kind":"signal","number":22,"title":"哪一队做出示意","en":"Who Made the Call","description":"双臂伸直，指向做出示意的队伍所防守的得分区。","refs":["15.13"],"aliases":["哪队","示意方","who made the call"],"image":"wfdf/visuals/signal-22.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=2"},{"id":"signal-23","kind":"signal","number":23,"title":"未影响比赛","en":"Did Not Affect the Play","description":"一只手张开举过头顶，前后挥动。","refs":["16.3"],"aliases":["未影响","不影响","did not affect"],"image":"wfdf/visuals/signal-23.png","source":"https://rules.wfdf.sport/wp-content/uploads/2025/03/WFDF-Rules-of-Ultimate-2025-2028-Hand-Signals.pdf#page=2"},{"id":"signal-24","kind":"signal","number":24,"title":"赛点","en":"Match Point","description":"双臂伸直指向左上方，掌心向下。","refs":["4.2","A4"],"aliases":["赛点","match point"],"image":"wfdf/visuals/signal-24.png","source":"https://rules.wfdf.sport/wp-content/u