# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
EDITOR_KEY=replace-with-a-random-key-of-at-least-24-characters
# Optional team entry code (at least 8 characters). Unset: log in with EDITOR_KEY.
# Keep EDITOR_KEY random; rotating it expires existing editor and player cookies.
EDITOR_PASSWORD=
PUBLIC_ORIGIN=https://jaredan.site
COOKIE_PATH=/frisbee/

# Optional: keep the real API key only in the server's private .env.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_RULES_MODEL=deepseek-flash
AI_TACTIC_MODEL=deepseek-v4-pro
AI_HOURLY_LIMIT=200
